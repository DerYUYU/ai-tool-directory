---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Das größte KI-Tool Verzeichnis. Vergleiche ChatGPT, Midjourney, GitHub Copilot und 100+ KI-Tools mit echten Bewertungen und Preisvergleich.',
  ogImage = '/og-default.png',
  canonicalUrl,
} = Astro.props;

const siteTitle = `${title} | Tooly-AI`;
const canonical = canonicalUrl || Astro.url.href;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta -->
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Tooly-AI" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Schema.org -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Tooly-AI",
      "url": "https://tooly-ai.dev",
      "description": "Das größte KI-Tool Verzeichnis — kostenlos, affiliate-frei, täglich aktualisiert",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://tooly-ai.dev/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- Plausible Analytics (DSGVO-konform, kein Cookie-Banner nötig) -->
  <!-- Aktivieren: Auf https://plausible.io registrieren + Domain "tooly-ai.dev" hinzufügen -->
  <script defer data-domain="tooly-ai.dev" src="https://plausible.io/js/script.js"></script>

  <slot name="head" />
</head>
<body>

  <!-- ═══════════════════════════════════════════ NAV ══ -->
  <nav>
    <div class="container nav-inner">

      <!-- Logo -->
      <a href="/" class="nav-logo">
        <span>🤖</span>
        <span>Tooly<span class="logo-accent">-AI</span></span>
      </a>

      <!-- Links -->
      <div class="nav-links">
        <a href="/categories/Writing"     class={currentPath.includes('Writing')     ? 'active' : ''}>Writing</a>
        <a href="/categories/Coding"      class={currentPath.includes('Coding')      ? 'active' : ''}>Coding</a>
        <a href="/categories/Design"      class={currentPath.includes('Design')      ? 'active' : ''}>Design</a>
        <a href="/categories/Productivity" class={currentPath.includes('Productivity') ? 'active' : ''}>Productivity</a>
        <a href="/categories/Video"       class={currentPath.includes('Video')       ? 'active' : ''}>Video</a>
        <a href="/categories/Business"    class={currentPath.includes('Business')    ? 'active' : ''}>Business</a>
        <a href="/categories/Research"    class={currentPath.includes('Research')    ? 'active' : ''}>Research</a>
        <a href="/finder" class={currentPath.includes('finder') ? 'active' : ''} style="color:var(--accent-light)">🤖 Finder</a>
      </div>

      <!-- CTA -->
      <div class="nav-cta">
        <a href="/newsletter" class="btn btn-ghost" style="padding:0.5rem 1rem;font-size:0.82rem">
          📬 Newsletter
        </a>
        <a href="/submit" class="btn btn-primary" style="padding:0.5rem 1.1rem;font-size:0.82rem">
          + Tool einreichen
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════ MAIN ══ -->
  <main>
    <slot />
  </main>

  <!-- ═══════════════════════════════════════════ FOOTER ══ -->
  <footer>
    <div class="container">
      <div class="footer-grid">

        <!-- Brand -->
        <div class="footer-col">
          <div class="footer-logo">🤖 Tooly<span class="logo-accent">-AI</span></div>
          <p style="font-size:0.85rem;line-height:1.7;max-width:280px;margin-bottom:1.5rem">
            Das größte deutschsprachige KI-Tool Verzeichnis.
            Täglich aktualisiert — ehrlich, ohne versteckte Empfehlungen.
          </p>
          <div style="display:flex;gap:0.75rem">
            <a href="/newsletter" class="btn btn-outline" style="font-size:0.78rem;padding:0.4rem 0.9rem">📬 Newsletter</a>
            <a href="/submit"     class="btn btn-ghost"   style="font-size:0.78rem;padding:0.4rem 0.9rem">+ Tool einreichen</a>
          </div>
        </div>

        <!-- Kategorien -->
        <div class="footer-col">
          <h4>Kategorien</h4>
          <a href="/categories/Writing">✍️ Writing</a>
          <a href="/categories/Coding">💻 Coding</a>
          <a href="/categories/Design">🎨 Design</a>
          <a href="/categories/Video">🎬 Video</a>
          <a href="/categories/Audio">🎵 Audio</a>
          <a href="/categories/Productivity">⚡ Productivity</a>
          <a href="/categories/Business">💼 Business</a>
          <a href="/categories/Research">🔬 Research</a>
        </div>

        <!-- Top Tools -->
        <div class="footer-col">
          <h4>Top Tools</h4>
          <a href="/tools/chatgpt">ChatGPT</a>
          <a href="/tools/claude">Claude</a>
          <a href="/tools/midjourney">Midjourney</a>
          <a href="/tools/github-copilot">GitHub Copilot</a>
          <a href="/tools/cursor">Cursor</a>
          <a href="/tools/perplexity">Perplexity</a>
          <a href="/tools/elevenlabs">ElevenLabs</a>
          <a href="/tools/runway-ml">Runway ML</a>
        </div>

        <!-- Seiten -->
        <div class="footer-col">
          <h4>Mehr</h4>
          <a href="/about">Über uns</a>
          <a href="/finder">🤖 KI-Finder</a>
          <a href="/newsletter">📬 Newsletter</a>
          <a href="/submit">Tool einreichen</a>
          <a href="/sitemap-index.xml">Sitemap</a>
          <a href="mailto:yilcay.b@gmail.com">Kontakt</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <div>
          <strong style="color:var(--text)">🤖 Tooly-AI</strong>
          &nbsp;— © 2026 · Made with ❤️ in Deutschland
        </div>
        <div style="display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap">
          <span style="color:var(--text-dim)">Diese Seite enthält Affiliate-Links.</span>
          <a href="/impressum" style="color:var(--text-dim);font-size:0.8rem;text-decoration:none">Impressum</a>
          <a href="/datenschutz" style="color:var(--text-dim);font-size:0.8rem;text-decoration:none">Datenschutz</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Footer logo accent style -->
  <style>
    .footer-logo .logo-accent {
      background: var(--grad-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

</body>
</html>

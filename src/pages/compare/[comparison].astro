---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const comparisons = [
    ['chatgpt', 'claude'],
    ['cursor', 'github-copilot'],
    ['midjourney', 'dall-e-3'],
    ['cursor', 'windsurf'],
    ['chatgpt', 'gemini'],
    ['midjourney', 'stable-diffusion'],
    ['notion-ai', 'mem-ai'],
    ['zapier', 'make-com'],
    ['elevenlabs', 'murf-ai'],
    ['suno-ai', 'udio'],
    ['perplexity', 'notebooklm'],
    ['github-copilot', 'codeium'],
    ['heygen', 'synthesia'],
    ['jasper-ai', 'writesonic'],
    ['runway-ml', 'pika'],
  ];

  const allTools = await getCollection('tools');
  const toolMap = Object.fromEntries(allTools.map(t => [t.id, t]));

  return comparisons
    .filter(([a, b]) => toolMap[a] && toolMap[b])
    .map(([slugA, slugB]) => ({
      params: { comparison: `${slugA}-vs-${slugB}` },
      props: { toolA: toolMap[slugA], toolB: toolMap[slugB] },
    }));
}

const { toolA, toolB } = Astro.props;
const SITE_URL = 'https://tooly-ai.dev';

const metaTitle = `${toolA.data.name} vs. ${toolB.data.name}: Der große Vergleich 2026`;
const metaDesc = `${toolA.data.name} oder ${toolB.data.name}? Wir vergleichen Preise, Features und Bewertungen — damit du die richtige Wahl triffst.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": metaTitle,
  "description": metaDesc,
  "url": `${SITE_URL}/compare/${toolA.id}-vs-${toolB.id}`,
};

function renderStars(r: number) {
  return '★'.repeat(Math.floor(r)) + '☆'.repeat(5 - Math.floor(r));
}

function winnerClass(a: number, b: number) {
  if (a > b) return 'winner';
  if (b > a) return 'loser';
  return 'tie';
}
---

<BaseLayout title={metaTitle} description={metaDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <style>
    .compare-hero {
      text-align: center;
      padding: 3rem 1rem 2rem;
    }
    .vs-badge {
      display: inline-block;
      background: var(--accent-dim);
      color: var(--accent-light);
      border: 1px solid rgba(124,106,247,0.3);
      border-radius: 99px;
      padding: 0.2rem 0.9rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 1rem;
    }
    .compare-hero h1 {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 800;
      margin-bottom: 0.5rem;
    }
    .compare-hero p {
      color: var(--text-muted);
      max-width: 560px;
      margin: 0 auto;
      font-size: 1rem;
    }

    .compare-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
      align-items: start;
      max-width: 900px;
      margin: 2.5rem auto;
      padding: 0 1rem;
    }
    .compare-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
    }
    .compare-card.highlight {
      border-color: rgba(124,106,247,0.4);
      background: linear-gradient(135deg, rgba(124,106,247,0.07) 0%, rgba(34,211,238,0.03) 100%);
    }
    .tool-header { text-align: center; margin-bottom: 1.5rem; }
    .tool-icon { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
    .tool-name { font-size: 1.3rem; font-weight: 800; margin-bottom: 0.25rem; }
    .tool-tagline { color: var(--text-muted); font-size: 0.85rem; }
    .tool-rating { margin: 0.75rem 0; font-size: 1rem; }

    .vs-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: 4rem;
    }
    .vs-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--accent-dim);
      border: 2px solid var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: var(--accent-light);
      font-size: 0.9rem;
    }

    .compare-table {
      max-width: 900px;
      margin: 0 auto 3rem;
      padding: 0 1rem;
    }
    .compare-table h2 {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 1rem;
      text-align: center;
    }
    .compare-row {
      display: grid;
      grid-template-columns: 1fr 160px 1fr;
      gap: 0.75rem;
      align-items: center;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }
    .compare-row:last-child { border-bottom: none; }
    .row-label {
      text-align: center;
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .row-val {
      font-size: 0.9rem;
      padding: 0.5rem 0.85rem;
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      border: 1px solid var(--border);
      text-align: center;
    }
    .row-val.winner {
      border-color: rgba(34,197,94,0.4);
      background: rgba(34,197,94,0.07);
      color: var(--green);
      font-weight: 600;
    }
    .row-val.loser {
      opacity: 0.65;
    }

    .verdict-section {
      max-width: 700px;
      margin: 0 auto 3rem;
      padding: 0 1rem;
    }
    .verdict-section h2 {
      font-size: 1.3rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .verdict-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .verdict-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem;
    }
    .verdict-card h3 {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent-light);
      margin-bottom: 0.75rem;
    }
    .verdict-card ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .verdict-card li {
      font-size: 0.82rem;
      color: var(--text-muted);
      display: flex;
      gap: 0.5rem;
    }
    .verdict-card li::before { content: '✓'; color: var(--green); flex-shrink: 0; }

    .cta-section {
      max-width: 700px;
      margin: 0 auto 5rem;
      padding: 0 1rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .cta-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      text-align: center;
    }

    @media (max-width: 600px) {
      .compare-grid { grid-template-columns: 1fr; }
      .vs-divider { padding: 0; }
      .compare-row { grid-template-columns: 1fr 120px 1fr; font-size: 0.8rem; }
      .verdict-grid, .cta-section { grid-template-columns: 1fr; }
    }
  </style>

  <div class="container">
    <div class="compare-hero">
      <span class="vs-badge">VERGLEICH 2026</span>
      <h1>{toolA.data.name} vs. {toolB.data.name}</h1>
      <p>Welches Tool ist das Richtige für dich? Wir vergleichen Preise, Features und Bewertungen.</p>
    </div>

    <!-- Hero Cards -->
    <div class="compare-grid">
      <div class={`compare-card ${toolA.data.rating >= toolB.data.rating ? 'highlight' : ''}`}>
        <div class="tool-header">
          <span class="tool-icon">🤖</span>
          <div class="tool-name">{toolA.data.name}</div>
          <div class="tool-tagline">{toolA.data.tagline}</div>
          <div class="tool-rating">{renderStars(toolA.data.rating)} <strong>{toolA.data.rating}/5</strong></div>
        </div>
        <p style="font-size:0.85rem;color:var(--text-muted);line-height:1.7">{toolA.data.description.slice(0,200)}...</p>
        <div style="margin-top:1rem">
          {toolA.data.pricing.free
            ? <span class="badge badge-free" style="font-size:0.75rem">Kostenlose Version</span>
            : <span class="badge badge-paid" style="font-size:0.75rem">Ab {toolA.data.pricing.startingPrice}/Monat</span>
          }
        </div>
      </div>

      <div class="vs-divider">
        <div class="vs-circle">VS</div>
      </div>

      <div class={`compare-card ${toolB.data.rating > toolA.data.rating ? 'highlight' : ''}`}>
        <div class="tool-header">
          <span class="tool-icon">⚡</span>
          <div class="tool-name">{toolB.data.name}</div>
          <div class="tool-tagline">{toolB.data.tagline}</div>
          <div class="tool-rating">{renderStars(toolB.data.rating)} <strong>{toolB.data.rating}/5</strong></div>
        </div>
        <p style="font-size:0.85rem;color:var(--text-muted);line-height:1.7">{toolB.data.description.slice(0,200)}...</p>
        <div style="margin-top:1rem">
          {toolB.data.pricing.free
            ? <span class="badge badge-free" style="font-size:0.75rem">Kostenlose Version</span>
            : <span class="badge badge-paid" style="font-size:0.75rem">Ab {toolB.data.pricing.startingPrice}/Monat</span>
          }
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="compare-table">
      <h2>Direktvergleich</h2>

      <div class="compare-row">
        <div class={`row-val ${winnerClass(toolA.data.rating, toolB.data.rating)}`}>{toolA.data.rating}/5 {renderStars(toolA.data.rating)}</div>
        <div class="row-label">Bewertung</div>
        <div class={`row-val ${winnerClass(toolB.data.rating, toolA.data.rating)}`}>{toolB.data.rating}/5 {renderStars(toolB.data.rating)}</div>
      </div>

      <div class="compare-row">
        <div class={`row-val ${toolA.data.pricing.free ? 'winner' : 'loser'}`}>{toolA.data.pricing.free ? '✅ Kostenlos verfügbar' : '❌ Kein Free Tier'}</div>
        <div class="row-label">Gratis-Version</div>
        <div class={`row-val ${toolB.data.pricing.free ? 'winner' : 'loser'}`}>{toolB.data.pricing.free ? '✅ Kostenlos verfügbar' : '❌ Kein Free Tier'}</div>
      </div>

      <div class="compare-row">
        <div class="row-val">{toolA.data.pricing.startingPrice ? `Ab ${toolA.data.pricing.startingPrice}/Mo` : 'Kostenlos'}</div>
        <div class="row-label">Preis</div>
        <div class="row-val">{toolB.data.pricing.startingPrice ? `Ab ${toolB.data.pricing.startingPrice}/Mo` : 'Kostenlos'}</div>
      </div>

      <div class="compare-row">
        <div class="row-val">{toolA.data.category}</div>
        <div class="row-label">Kategorie</div>
        <div class="row-val">{toolB.data.category}</div>
      </div>

      <div class="compare-row">
        <div class={`row-val ${winnerClass(toolA.data.pros.length, toolB.data.pros.length)}`}>{toolA.data.pros.length} Vorteile</div>
        <div class="row-label">Vorteile</div>
        <div class={`row-val ${winnerClass(toolB.data.pros.length, toolA.data.pros.length)}`}>{toolB.data.pros.length} Vorteile</div>
      </div>
    </div>

    <!-- Verdict -->
    <div class="verdict-section">
      <h2>Wann welches Tool wählen?</h2>
      <div class="verdict-grid">
        <div class="verdict-card">
          <h3>Wähle {toolA.data.name} wenn...</h3>
          <ul>
            {toolA.data.pros.slice(0,3).map(p => <li>{p}</li>)}
          </ul>
        </div>
        <div class="verdict-card">
          <h3>Wähle {toolB.data.name} wenn...</h3>
          <ul>
            {toolB.data.pros.slice(0,3).map(p => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="cta-section">
      <div class="cta-card">
        <div style="font-size:1.5rem;margin-bottom:0.5rem">🚀</div>
        <h3 style="font-size:1rem;margin-bottom:0.5rem">{toolA.data.name} testen</h3>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1rem">{toolA.data.pricing.free ? 'Kostenlos starten' : `Ab ${toolA.data.pricing.startingPrice}/Monat`}</p>
        <a href={toolA.data.affiliateLink || toolA.data.websiteUrl} target="_blank" rel="noopener" class="btn btn-primary" style="font-size:0.82rem;padding:0.6rem 1.2rem">
          {toolA.data.name} öffnen →
        </a>
        <br/><br/>
        <a href={`/tools/${toolA.id}`} style="font-size:0.78rem;color:var(--text-muted)">Vollständige Bewertung lesen</a>
      </div>
      <div class="cta-card">
        <div style="font-size:1.5rem;margin-bottom:0.5rem">⚡</div>
        <h3 style="font-size:1rem;margin-bottom:0.5rem">{toolB.data.name} testen</h3>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1rem">{toolB.data.pricing.free ? 'Kostenlos starten' : `Ab ${toolB.data.pricing.startingPrice}/Monat`}</p>
        <a href={toolB.data.affiliateLink || toolB.data.websiteUrl} target="_blank" rel="noopener" class="btn btn-outline" style="font-size:0.82rem;padding:0.6rem 1.2rem">
          {toolB.data.name} öffnen →
        </a>
        <br/><br/>
        <a href={`/tools/${toolB.id}`} style="font-size:0.78rem;color:var(--text-muted)">Vollständige Bewertung lesen</a>
      </div>
    </div>
  </div>
</BaseLayout>

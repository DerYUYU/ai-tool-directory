---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const featuredTools = allTools.filter(t => t.data.featured).slice(0, 6);
const recentTools = [...allTools].sort((a, b) =>
  b.data.addedDate.getTime() - a.data.addedDate.getTime()
).slice(0, 12);

const displayTools = recentTools.length > 0 ? recentTools : allTools;

const categories = ['Writing', 'Coding', 'Design', 'Productivity', 'Video', 'Audio', 'Business', 'Research'];

const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat] = allTools.filter(t => t.data.category === cat).length;
  return acc;
}, {} as Record<string, number>);

function renderStars(rating: number) {
  return '★'.repeat(Math.floor(rating)) + '☆'.repeat(5 - Math.floor(rating));
}
---

<BaseLayout
  title="Beste KI-Tools 2026 entdecken & vergleichen"
  description="Das größte deutsche KI-Tool-Verzeichnis. Vergleiche Funktionen, Preise und echte Bewertungen für ChatGPT, Midjourney, GitHub Copilot und 100+ weitere KI-Tools."
>

  <!-- ═══════════════════════════════════════════ HERO ══ -->
  <section class="hero">
    <div class="container">

      <!-- Floating badge -->
      <div style="display:flex;justify-content:center;margin-bottom:1.5rem">
        <span class="badge badge-new" style="font-size:0.78rem;padding:0.35rem 1.1rem">
          🤖 {allTools.length} KI-Tools &nbsp;·&nbsp; täglich aktualisiert
        </span>
      </div>

      <!-- Headline -->
      <h1 style="text-align:center;margin-bottom:1.25rem;letter-spacing:-0.03em">
        Das smarteste<br/>
        <span class="grad-text">KI-Tool Verzeichnis</span>
      </h1>

      <!-- Sub-headline -->
      <p style="text-align:center;color:var(--text-muted);font-size:1.15rem;max-width:580px;margin:0 auto 2.5rem;line-height:1.7">
        Vergleiche die besten KI-Tools für Writing, Coding, Design und mehr —
        mit echten Bewertungen, Preisen und Affiliate-freien Einschätzungen.
      </p>

      <!-- Search -->
      <div class="search-wrap" style="margin-bottom:2rem">
        <span class="search-icon">🔍</span>
        <input
          id="search"
          type="text"
          class="search-input"
          placeholder="ChatGPT, Midjourney, GitHub Copilot suchen..."
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <!-- Category Pills -->
      <div class="pills" style="justify-content:center">
        <button class="pill active" data-filter="all">Alle</button>
        {categories.map(cat => (
          <a href={`/categories/${cat}`} class="pill">{cat}
            {categoryCounts[cat] > 0 && (
              <span style="font-size:0.7rem;opacity:0.6;margin-left:0.2rem">({categoryCounts[cat]})</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ STATS BAR ══ -->
  <section style="padding:0 0 3rem">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;text-align:center">
        <div class="card" style="padding:1.25rem">
          <div class="grad-text" style="font-size:2rem;font-weight:800;line-height:1">{allTools.length}+</div>
          <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.4rem">KI-Tools</div>
        </div>
        <div class="card" style="padding:1.25rem">
          <div class="grad-text" style="font-size:2rem;font-weight:800;line-height:1">{categories.length}</div>
          <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.4rem">Kategorien</div>
        </div>
        <div class="card" style="padding:1.25rem">
          <div class="grad-text" style="font-size:2rem;font-weight:800;line-height:1">7</div>
          <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.4rem">Affiliate-Links</div>
        </div>
        <div class="card" style="padding:1.25rem">
          <div class="grad-text" style="font-size:2rem;font-weight:800;line-height:1">€0</div>
          <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.4rem">Für dich</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ FEATURED TOOLS ══ -->
  {featuredTools.length > 0 && (
    <section style="padding:0 0 4rem">
      <div class="container">
        <div class="section-title">
          <h2>⭐ <span class="grad-text">Top Tools</span></h2>
          <p style="color:var(--text-muted)">Die meist genutzten und bestbewerteten KI-Tools</p>
        </div>
        <div class="tools-grid">
          {featuredTools.map(tool => (
            <a href={`/tools/${tool.id}`} style="text-decoration:none;display:block">
              <div class="tool-card">
                <div class="tool-card-header">
                  <div style="flex:1;min-width:0">
                    <div class="tool-card-title">{tool.data.name}</div>
                    <div class="tool-card-tagline">{tool.data.tagline}</div>
                  </div>
                  <div class="stars" title={`${tool.data.rating}/5`} style="font-size:0.85rem;white-space:nowrap">
                    {renderStars(tool.data.rating)}
                  </div>
                </div>
                <div class="tool-card-meta">
                  <span class="badge badge-category">{tool.data.category}</span>
                  {tool.data.pricing.free
                    ? <span class="badge badge-free">Kostenlos</span>
                    : <span class="badge badge-paid">Ab {tool.data.pricing.startingPrice}</span>
                  }
                  {tool.data.affiliateLink && (
                    <span class="badge" style="background:rgba(34,211,238,0.08);color:var(--cyan);border:1px solid rgba(34,211,238,0.2)">💰</span>
                  )}
                </div>
                <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.55;flex:1">
                  {tool.data.description.slice(0, 110)}...
                </p>
                <div class="tool-card-footer">
                  <span style="font-size:0.78rem;color:var(--text-dim)">{tool.data.pricing.freeTier ?? ''}</span>
                  <span style="font-size:0.82rem;color:var(--accent-light);font-weight:600">Details →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════ ALL TOOLS ══ -->
  <section style="padding:0 0 5rem">
    <div class="container">
      <div class="section-title" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
        <div>
          <h2>🆕 <span class="grad-text">Alle Tools</span></h2>
          <p style="color:var(--text-muted)">{allTools.length} KI-Tools — täglich neue hinzugefügt</p>
        </div>
        <span id="result-count" style="font-size:0.85rem;color:var(--text-muted)"></span>
      </div>

      <div class="tools-grid" id="tools-container">
        {displayTools.map(tool => (
          <a
            href={`/tools/${tool.id}`}
            style="text-decoration:none;display:block"
            class="tool-link"
            data-name={tool.data.name.toLowerCase()}
            data-cat={tool.data.category.toLowerCase()}
            data-tags={tool.data.tags?.join(' ').toLowerCase() ?? ''}
          >
            <div class="tool-card">
              <div class="tool-card-header">
                <div style="flex:1;min-width:0">
                  <div class="tool-card-title">{tool.data.name}</div>
                  <div class="tool-card-tagline">{tool.data.tagline}</div>
                </div>
                <div class="stars" title={`${tool.data.rating}/5`} style="font-size:0.8rem;white-space:nowrap">
                  {renderStars(tool.data.rating)}
                </div>
              </div>
              <div class="tool-card-meta">
                <span class="badge badge-category">{tool.data.category}</span>
                {tool.data.pricing.free
                  ? <span class="badge badge-free">Free</span>
                  : <span class="badge badge-paid">{tool.data.pricing.startingPrice ?? 'Paid'}</span>
                }
                {tool.data.affiliateLink && (
                  <span style="font-size:0.72rem;color:var(--cyan);opacity:0.8">💰</span>
                )}
              </div>
              <div class="tool-card-footer">
                <span style="font-size:0.78rem;color:var(--text-dim)">
                  {tool.data.pricing.freeTier ? `✓ ${tool.data.pricing.freeTier}` : ''}
                </span>
                <span style="font-size:0.82rem;color:var(--accent-light);font-weight:600">Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-results" style="display:none;text-align:center;padding:5rem 2rem;color:var(--text-muted)">
        <div style="font-size:3rem;margin-bottom:1rem">🔍</div>
        <p style="font-size:1.1rem">Kein Tool gefunden.<br/>Versuch einen anderen Suchbegriff.</p>
      </div>

      {allTools.length === 0 && (
        <div style="text-align:center;padding:5rem;color:var(--text-muted)">
          <div style="font-size:3rem;margin-bottom:1rem">🚧</div>
          <p>Tools werden gerade hinzugefügt... komm morgen wieder!</p>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════════════════════════════ NEWSLETTER CTA ══ -->
  <section style="padding:0 0 5rem">
    <div class="container">
      <div class="card" style="
        text-align:center;
        padding:4rem 2rem;
        background: linear-gradient(135deg, rgba(124,106,247,0.12) 0%, rgba(34,211,238,0.05) 100%);
        border-color: rgba(124,106,247,0.3);
        position:relative;
        overflow:hidden;
      ">
        <!-- Ambient glow -->
        <div style="
          position:absolute;
          top:50%;left:50%;
          transform:translate(-50%,-50%);
          width:600px;height:300px;
          background:radial-gradient(ellipse,rgba(124,106,247,0.12) 0%,transparent 70%);
          pointer-events:none;
        "></div>

        <div style="position:relative;z-index:1">
          <div class="badge badge-new" style="margin-bottom:1.5rem;font-size:0.78rem">
            📬 Newsletter
          </div>
          <h2 style="margin-bottom:1rem">
            Neue KI-Tools<br/><span class="grad-text">jede Woche in dein Postfach</span>
          </h2>
          <p style="color:var(--text-muted);max-width:460px;margin:0 auto 2rem;line-height:1.7">
            Werde der Erste, der neue KI-Tools entdeckt.
            Kein Spam. Jederzeit abmeldbar.
          </p>
          <a href="/newsletter" class="btn btn-primary" style="font-size:1rem;padding:0.85rem 2.5rem">
            Kostenlos abonnieren →
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- ════════════════════════════════════════ LIVE SEARCH JS ══ -->
<script>
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const toolLinks   = document.querySelectorAll<HTMLElement>('.tool-link');
  const noResults   = document.getElementById('no-results');
  const resultCount = document.getElementById('result-count');

  function updateCount(visible: number, total: number) {
    if (resultCount) {
      resultCount.textContent = visible < total ? `${visible} von ${total} Tools` : '';
    }
  }

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    let visible = 0;

    toolLinks.forEach(link => {
      const name = link.dataset.name ?? '';
      const cat  = link.dataset.cat  ?? '';
      const tags = link.dataset.tags ?? '';
      const match = !q || name.includes(q) || cat.includes(q) || tags.includes(q);
      link.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    const total = toolLinks.length;
    updateCount(visible, total);
    if (noResults) noResults.style.display = (q && visible === 0) ? 'block' : 'none';
  });
</script>

<style>
  .section-title {
    margin-bottom: 2rem;
  }
  .section-title h2 {
    margin-bottom: 0.4rem;
  }

  /* Hero padding */
  .hero {
    padding: 5rem 0 3rem;
  }

  @media (max-width: 640px) {
    .hero { padding: 3rem 0 2rem; }
    /* Stack stats bar 2x2 on mobile */
    div[style*="grid-template-columns:repeat(4"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const featuredTools = allTools.filter(t => t.data.featured).slice(0, 6);
const trendingTools = allTools.filter(t => (t.data as any).trending).slice(0, 4);
// Alle Tools nach Datum sortiert — kein Slice → Suche findet alle Tools!
const displayTools = [...allTools].sort(
  (a, b) => b.data.addedDate.getTime() - a.data.addedDate.getTime()
);

const categories = [
  { name: 'Writing',      icon: '✍️' },
  { name: 'Coding',       icon: '💻' },
  { name: 'Design',       icon: '🎨' },
  { name: 'Productivity', icon: '⚡' },
  { name: 'Video',        icon: '🎬' },
  { name: 'Audio',        icon: '🎵' },
  { name: 'Business',     icon: '💼' },
  { name: 'Research',     icon: '🔬' },
];

const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat.name] = allTools.filter(t => t.data.category === cat.name).length;
  return acc;
}, {} as Record<string, number>);

const freeCount = allTools.filter(t => t.data.pricing.free).length;

function renderStars(rating: number) {
  return '★'.repeat(Math.floor(rating)) + '☆'.repeat(5 - Math.floor(rating));
}
---

<BaseLayout
  title="Beste KI-Tools 2026 entdecken & vergleichen"
  description="Das größte deutsche KI-Tool-Verzeichnis. Vergleiche ChatGPT, Midjourney, GitHub Copilot und 100+ weitere KI-Tools — mit echten Bewertungen, Preisen und Affiliate-freien Einschätzungen."
>

  <!-- ═══════════════════════════════════════════ HERO ══ -->
  <section class="hero">
    <div class="container" style="position:relative;z-index:2">

      <!-- Badge -->
      <div style="display:flex;justify-content:center;margin-bottom:1.75rem;animation:fadeUp 0.6s ease both">
        <div class="badge badge-new" style="font-size:0.8rem;padding:0.4rem 1.25rem;gap:0.5rem">
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan)"></span>
          {allTools.length} KI-Tools &nbsp;·&nbsp; täglich aktualisiert &nbsp;·&nbsp; {freeCount} kostenlos
        </div>
      </div>

      <!-- Headline -->
      <h1 style="text-align:center;margin-bottom:1.5rem;animation:fadeUp 0.6s 0.1s ease both;opacity:0">
        Finde das perfekte<br/>
        <span class="grad-text">KI-Tool für dich</span>
      </h1>

      <!-- Sub-headline -->
      <p style="
        text-align:center;
        color:var(--text-muted);
        font-size:1.2rem;
        max-width:600px;
        margin:0 auto 2.75rem;
        line-height:1.75;
        animation:fadeUp 0.6s 0.2s ease both;
        opacity:0;
      ">
        Vergleiche die besten KI-Tools für Writing, Coding, Design und mehr —
        mit echten Bewertungen, Preisen und Affiliate-freien Einschätzungen.
      </p>

      <!-- Search -->
      <div style="max-width:600px;margin:0 auto 2.25rem;animation:fadeUp 0.6s 0.3s ease both;opacity:0">
        <div class="search-wrap" style="margin-bottom:0;position:relative">
          <span class="search-icon">🔍</span>
          <input
            id="search"
            type="text"
            class="search-input"
            placeholder="ChatGPT, Midjourney, Cursor, ElevenLabs suchen..."
            autocomplete="off"
            spellcheck="false"
          />
          <kbd id="search-esc" style="
            display:none;
            position:absolute;right:1rem;top:50%;transform:translateY(-50%);
            font-size:0.7rem;padding:0.2rem 0.45rem;border-radius:4px;
            background:rgba(255,255,255,0.08);border:1px solid var(--border);
            color:var(--text-dim);cursor:pointer;font-family:var(--font-sans);
          ">ESC</kbd>
        </div>
      </div>

      <!-- Category Pills -->
      <div class="pills" style="justify-content:center;animation:fadeUp 0.6s 0.4s ease both;opacity:0">
        <button class="pill active" data-filter="all">Alle</button>
        {categories.map(cat => (
          <a href={`/categories/${cat.name}`} class="pill">
            {cat.icon} {cat.name}
            {categoryCounts[cat.name] > 0 && (
              <span style="font-size:0.68rem;opacity:0.5;margin-left:0.15rem">({categoryCounts[cat.name]})</span>
            )}
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════ STATS BAR ══ -->
  <section style="padding:2.5rem 0 3rem">
    <div class="container">
      <div class="stats-bar">
        <div class="card stat-item" style="padding:1.75rem">
          <div class="stat-number">{allTools.length}+</div>
          <div class="stat-label">KI-Tools kuratiert</div>
        </div>
        <div class="card stat-item" style="padding:1.75rem">
          <div class="stat-number">{freeCount}</div>
          <div class="stat-label">Tools kostenlos</div>
        </div>
        <div class="card stat-item" style="padding:1.75rem">
          <div class="stat-number">{categories.length}</div>
          <div class="stat-label">Kategorien</div>
        </div>
        <div class="card stat-item" style="padding:1.75rem">
          <div class="stat-number">€0</div>
          <div class="stat-label">Keine versteckten Kosten</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ 🔥 TRENDING ══ -->
  {trendingTools.length > 0 && (
    <section style="padding:0 0 4.5rem">
      <div class="container">
        <div class="section-title" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
          <div>
            <h2>🔥 <span class="grad-text" style="background:var(--grad-fire);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Trending jetzt</span></h2>
            <p style="color:var(--text-muted)">Die heißesten KI-Tools im Moment</p>
          </div>
          <span class="badge badge-trending" style="font-size:0.75rem">Live aktualisiert</span>
        </div>
        <div class="tools-grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
          {trendingTools.map(tool => (
            <a href={`/tools/${tool.id}`} style="text-decoration:none;display:block">
              <div class="tool-card trending">
                <div class="tool-card-header">
                  <div style="flex:1;min-width:0">
                    <div class="tool-card-title">{tool.data.name}</div>
                    <div class="tool-card-tagline">{tool.data.tagline}</div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.4rem;flex-shrink:0">
                    <span class="badge badge-hot">🔥 Trending</span>
                    <div class="stars" style="font-size:0.78rem">{renderStars(tool.data.rating)}</div>
                  </div>
                </div>
                <div class="tool-card-meta">
                  <span class="badge badge-category">{tool.data.category}</span>
                  {tool.data.pricing.free
                    ? <span class="badge badge-free">Free</span>
                    : <span class="badge badge-paid">{tool.data.pricing.startingPrice ?? 'Paid'}</span>
                  }
                </div>
                <div class="tool-card-footer">
                  <span style="font-size:0.78rem;color:var(--text-dim)">
                    {tool.data.pricing.freeTier ? `✓ ${tool.data.pricing.freeTier}` : ''}
                  </span>
                  <span class="tool-card-footer-link">Details →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════ ⭐ FEATURED ══ -->
  {featuredTools.length > 0 && (
    <section style="padding:0 0 4.5rem">
      <div class="container">
        <div class="section-title">
          <h2>⭐ <span class="grad-text">Top Tools</span></h2>
          <p style="color:var(--text-muted)">Die meist genutzten und bestbewerteten KI-Tools</p>
        </div>
        <div class="tools-grid">
          {featuredTools.map((tool, i) => (
            <a href={`/tools/${tool.id}`} style="text-decoration:none;display:block">
              <div class="tool-card featured" style={`animation:fadeUp 0.5s ${i*0.08}s ease both;opacity:0`}>
                <div class="tool-card-header">
                  <div style="flex:1;min-width:0">
                    <div class="tool-card-title">{tool.data.name}</div>
                    <div class="tool-card-tagline">{tool.data.tagline}</div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;flex-shrink:0">
                    <div class="stars" style="font-size:0.82rem" title={`${tool.data.rating}/5`}>{renderStars(tool.data.rating)}</div>
                    <span style="font-size:0.7rem;color:var(--text-dim)">{tool.data.rating}/5</span>
                  </div>
                </div>
                <div class="tool-card-meta">
                  <span class="badge badge-category">{tool.data.category}</span>
                  {tool.data.pricing.free
                    ? <span class="badge badge-free">Kostenlos</span>
                    : <span class="badge badge-paid">Ab {tool.data.pricing.startingPrice}</span>
                  }
                  {tool.data.affiliateLink && (
                    <span class="badge" style="background:rgba(34,211,238,0.08);color:var(--cyan);border:1px solid rgba(34,211,238,0.2)">💰 Affiliate</span>
                  )}
                </div>
                <p class="tool-card-desc">
                  {tool.data.description.slice(0, 115)}...
                </p>
                <div class="tool-card-footer">
                  <span style="font-size:0.78rem;color:var(--text-dim)">{tool.data.pricing.freeTier ?? ''}</span>
                  <span class="tool-card-footer-link">Details →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════ ALLE TOOLS ══ -->
  <section style="padding:0 0 5rem">
    <div class="container">
      <div class="section-title" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
        <div>
          <h2>🆕 <span class="grad-text">Alle Tools</span></h2>
          <p style="color:var(--text-muted)">{allTools.length} KI-Tools — täglich neue hinzugefügt</p>
        </div>
        <span id="result-count" style="font-size:0.85rem;color:var(--text-muted)"></span>
      </div>

      <div class="tools-grid" id="tools-container">
        {displayTools.map(tool => (
          <a
            href={`/tools/${tool.id}`}
            style="text-decoration:none;display:block"
            class="tool-link"
            data-name={tool.data.name.toLowerCase()}
            data-display={tool.data.name}
            data-cat={tool.data.category.toLowerCase()}
            data-tags={tool.data.tags?.join(' ').toLowerCase() ?? ''}
            data-tagline={tool.data.tagline}
            data-free={tool.data.pricing.free ? '1' : '0'}
          >
            <div class={`tool-card${(tool.data as any).trending ? ' trending' : ''}`}>
              <div class="tool-card-header">
                <div style="flex:1;min-width:0">
                  <div class="tool-card-title">{tool.data.name}</div>
                  <div class="tool-card-tagline">{tool.data.tagline}</div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;flex-shrink:0">
                  <div class="stars" style="font-size:0.78rem">{renderStars(tool.data.rating)}</div>
                  {(tool.data as any).trending && <span class="badge badge-trending" style="font-size:0.6rem;padding:0.15rem 0.5rem">🔥</span>}
                </div>
              </div>
              <div class="tool-card-meta">
                <span class="badge badge-category">{tool.data.category}</span>
                {tool.data.pricing.free
                  ? <span class="badge badge-free">Free</span>
                  : <span class="badge badge-paid">{tool.data.pricing.startingPrice ?? 'Paid'}</span>
                }
                {tool.data.affiliateLink && (
                  <span style="font-size:0.72rem;color:var(--cyan);opacity:0.8">💰</span>
                )}
              </div>
              <div class="tool-card-footer">
                <span style="font-size:0.78rem;color:var(--text-dim)">
                  {tool.data.pricing.freeTier ? `✓ ${tool.data.pricing.freeTier}` : ''}
                </span>
                <span class="tool-card-footer-link">Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-results" style="display:none;text-align:center;padding:5rem 2rem;color:var(--text-muted)">
        <div style="font-size:3.5rem;margin-bottom:1rem">🔍</div>
        <p style="font-size:1.1rem">Kein Tool gefunden.<br/>Versuch einen anderen Suchbegriff.</p>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════ KATEGORIEN GRID ══ -->
  <section style="padding:0 0 5rem">
    <div class="container">
      <div class="section-title" style="text-align:center">
        <h2>Durchsuche nach <span class="grad-text">Kategorie</span></h2>
        <p style="color:var(--text-muted)">Finde das perfekte Tool für jeden Anwendungsfall</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">
        {categories.map(cat => (
          <a href={`/categories/${cat.name}`} style="text-decoration:none">
            <div class="card" style="text-align:center;padding:2rem 1rem;cursor:pointer">
              <div style="font-size:2.2rem;margin-bottom:0.75rem">{cat.icon}</div>
              <div style="font-weight:700;margin-bottom:0.35rem">{cat.name}</div>
              <div style="font-size:0.8rem;color:var(--text-muted)">
                {categoryCounts[cat.name]} Tools
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ NEWSLETTER ══ -->
  <section style="padding:0 0 6rem">
    <div class="container">
      <div class="newsletter-cta">
        <div style="position:relative;z-index:1">
          <div class="badge badge-new" style="margin-bottom:1.75rem;font-size:0.8rem">
            📬 Newsletter · kostenlos
          </div>
          <h2 style="margin-bottom:1.1rem;max-width:500px;margin-left:auto;margin-right:auto">
            Neue KI-Tools<br/><span class="grad-text">jede Woche in dein Postfach</span>
          </h2>
          <p style="color:var(--text-muted);max-width:460px;margin:0 auto 2.25rem;line-height:1.75">
            Werde der Erste, der neue KI-Tools entdeckt.
            Kein Spam. Jederzeit abmeldbar. Kein Bezahlwall.
          </p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
            <a href="/newsletter" class="btn btn-primary" style="font-size:1rem;padding:0.9rem 2.75rem">
              Kostenlos abonnieren →
            </a>
            <a href="/submit" class="btn btn-outline" style="font-size:1rem;padding:0.9rem 2rem">
              Tool einreichen
            </a>
          </div>
          <p style="font-size:0.78rem;color:var(--text-dim);margin-top:1.25rem">
            Bereits {allTools.length}+ Tools im Verzeichnis
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dropdown steht hier — KEIN transform-Parent → position:fixed funktioniert -->
  <div id="search-dropdown" style="
    display:none;
    position:fixed;
    z-index:9999;
    background:#12122a;
    border:1px solid rgba(124,106,247,0.4);
    border-radius:12px;
    box-shadow:0 24px 64px rgba(0,0,0,0.8),0 0 0 1px rgba(124,106,247,0.15);
    overflow:hidden;
    max-height:380px;
    overflow-y:auto;
  "></div>

  <!-- ══════════════════════════════════════════ SEARCH ══ -->
  <script is:inline>
  (function () {
    var ICONS = {
      writing:'✍️', coding:'💻', design:'🎨', productivity:'⚡',
      video:'🎬', audio:'🎵', business:'💼', research:'🔬'
    };

    function init() {
      var inp  = document.getElementById('search');
      var drop = document.getElementById('search-dropdown');
      var esc  = document.getElementById('search-esc');
      var all  = Array.prototype.slice.call(document.querySelectorAll('.tool-link'));

      if (!inp || !drop) return;

      /* ── Position des Dropdowns berechnen (position:fixed) ── */
      function reposition() {
        var r = inp.getBoundingClientRect();
        drop.style.left  = r.left  + 'px';
        drop.style.top   = (r.bottom + 6) + 'px';
        drop.style.width = r.width + 'px';
      }

      /* ── Dropdown anzeigen ─────────────────────────────── */
      function show(q) {
        if (!q) { hide(); return; }

        var hits = all.filter(function(l) {
          return (l.getAttribute('data-name') || '').indexOf(q) !== -1
              || (l.getAttribute('data-cat')  || '').indexOf(q) !== -1
              || (l.getAttribute('data-tags') || '').indexOf(q) !== -1;
        }).slice(0, 8);

        if (!hits.length) { hide(); return; }

        drop.innerHTML = '';

        hits.forEach(function(link) {
          var display = link.getAttribute('data-display') || link.getAttribute('data-name') || '';
          var tagline = link.getAttribute('data-tagline') || '';
          var cat     = link.getAttribute('data-cat')  || '';
          var free    = link.getAttribute('data-free') === '1';
          var href    = link.getAttribute('href') || '#';
          var icon    = ICONS[cat] || '🤖';

          var a = document.createElement('a');
          a.href = href;
          a.style.cssText =
            'display:flex;align-items:center;gap:12px;padding:11px 16px;' +
            'text-decoration:none;color:inherit;cursor:pointer;' +
            'border-bottom:1px solid rgba(255,255,255,0.04);' +
            'transition:background 0.1s;';

          a.innerHTML =
            '<span style="font-size:1.3rem;width:24px;text-align:center;flex-shrink:0">' + icon + '</span>' +
            '<span style="flex:1;min-width:0">' +
              '<b style="display:block;font-size:0.92rem;color:#f1f5f9;font-weight:600">' + display + '</b>' +
              '<span style="display:block;font-size:0.73rem;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + tagline + '</span>' +
            '</span>' +
            (free ? '<span style="flex-shrink:0;font-size:0.6rem;padding:2px 7px;border-radius:4px;background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3)">Free</span>' : '') +
            '<span style="flex-shrink:0;color:#475569;font-size:0.8rem">→</span>';

          a.addEventListener('mouseover',  function() { a.style.background = 'rgba(124,106,247,0.12)'; });
          a.addEventListener('mouseout',   function() { a.style.background = ''; });

          drop.appendChild(a);
        });

        reposition();
        drop.style.display = 'block';
        if (esc) esc.style.display = 'inline-flex';
      }

      /* ── Dropdown verstecken ───────────────────────────── */
      function hide() {
        drop.style.display = 'none';
        if (esc) esc.style.display = 'none';
      }

      /* ── Events ────────────────────────────────────────── */
      inp.addEventListener('input', function() {
        show(inp.value.toLowerCase().trim());
      });

      inp.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { inp.value = ''; hide(); }
      });

      /* Klick außerhalb → schließen (mousedown damit Klick auf Item noch durchkommt) */
      document.addEventListener('mousedown', function(e) {
        if (e.target !== inp && !drop.contains(e.target)) hide();
      });

      /* Seite scrollt → Dropdown schließen (nur wenn Maus NICHT über Dropdown) */
      window.addEventListener('scroll', function() {
        if (!drop.matches(':hover')) hide();
      }, { passive: true });

      /* Mausrad über Dropdown → Dropdown scrollen, Seite NICHT scrollen */
      drop.addEventListener('wheel', function(e) {
        e.preventDefault();
        e.stopPropagation();
        drop.scrollTop += e.deltaY;
      }, { passive: false });

      window.addEventListener('resize', function() { if (drop.style.display !== 'none') reposition(); });

      if (esc) {
        esc.addEventListener('mousedown', function(e) {
          e.preventDefault();
          inp.value = '';
          hide();
          inp.focus();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Submit an AI tool for free"
  description="Submit your AI tool for free and reach thousands of users on Tooly-AI."
>
  <div class="container" style="padding-top:5rem;padding-bottom:6rem;max-width:720px">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:3.5rem">
      <div style="font-size:3.5rem;margin-bottom:1rem">🚀</div>
      <h1 style="margin-bottom:0.75rem">Submit a tool for free</h1>
      <p style="color:var(--text-muted);font-size:1.05rem;line-height:1.7">
        Your AI tool is missing from the directory? We review all submissions manually
        and respond within 48 hours.
      </p>
    </div>

    <!-- Success message (hidden by default) -->
    <div id="success-msg" style="display:none" class="card" style="
      background:rgba(34,197,94,0.08);
      border-color:rgba(34,197,94,0.3);
      text-align:center;
      padding:2.5rem;
      margin-bottom:2rem;
    ">
      <div style="font-size:3rem;margin-bottom:0.75rem">✅</div>
      <h2 style="color:var(--green);margin-bottom:0.5rem">Submission received!</h2>
      <p style="color:var(--text-muted)">We will get back to you within 48h. Thanks for your submission!</p>
    </div>

    <!-- Main Form -->
    <div class="card" id="submit-form-wrap">
      <h2 style="margin-bottom:0.5rem;font-size:1.3rem">📝 Tool details</h2>
      <p style="color:var(--text-muted);font-size:0.85rem;margin-bottom:2rem">
        All fields marked with * are required.
      </p>

      <form
        id="tool-form"
        action="https://formspree.io/f/xojbpode"
        method="POST"
        style="display:flex;flex-direction:column;gap:1.25rem"
      >
        <!-- Hidden subject -->
        <input type="hidden" name="_subject" value="New tool submitted: Tooly-AI" />
        <input type="hidden" name="_next" value="" />
        <!-- Honeypot: Bots füllen das aus → Formspree blockiert automatisch -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <!-- Tool Name -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Tool name <span style="color:var(--red)">*</span>
          </label>
          <input
            type="text"
            name="tool_name"
            placeholder="e.g. ChatGPT, Midjourney..."
            required
            class="form-input"
          />
        </div>

        <!-- Website URL -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Website URL <span style="color:var(--red)">*</span>
          </label>
          <input
            type="url"
            name="website_url"
            placeholder="https://..."
            required
            class="form-input"
          />
        </div>

        <!-- Category -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Category <span style="color:var(--red)">*</span>
          </label>
          <select name="category" required class="form-input">
            <option value="">Please select...</option>
            <option value="Writing">✍️ Writing</option>
            <option value="Coding">💻 Coding</option>
            <option value="Design">🎨 Design</option>
            <option value="Productivity">⚡ Productivity</option>
            <option value="Video">🎬 Video</option>
            <option value="Audio">🎵 Audio</option>
            <option value="Business">💼 Business</option>
            <option value="Research">🔬 Research</option>
            <option value="Other">🔧 Other</option>
          </select>
        </div>

        <!-- Description -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Short description (1–2 sentences) <span style="color:var(--red)">*</span>
          </label>
          <textarea
            name="description"
            placeholder="What does the tool do? Who is it for?"
            required
            rows="3"
            class="form-input"
          ></textarea>
        </div>

        <!-- 2-col grid -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem">
          <div>
            <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
              Free tier available?
            </label>
            <select name="has_free" class="form-input">
              <option value="Ja">✅ Yes, free</option>
              <option value="Freemium">🟡 Freemium</option>
              <option value="Nein">❌ No, paid only</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
              Starting price
            </label>
            <input
              type="text"
              name="price"
              placeholder="e.g. $20/month or free"
              class="form-input"
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Your email (optional — for follow-up)
          </label>
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            class="form-input"
          />
        </div>

        <!-- Affiliate -->
        <div>
          <label style="display:block;font-size:0.85rem;font-weight:600;margin-bottom:0.4rem">
            Affiliate program available?
          </label>
          <input
            type="text"
            name="affiliate"
            placeholder="e.g. 30% commission, link: https://..."
            class="form-input"
          />
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary" id="submit-btn" style="justify-content:center;padding:0.9rem;font-size:1rem;margin-top:0.5rem">
          🚀 Submit tool
        </button>

        <p style="font-size:0.75rem;color:var(--text-dim);text-align:center">
          No spam. We review every tool manually. Response within 48h.
        </p>
      </form>
    </div>

    <!-- What happens next -->
    <div style="margin-top:3rem">
      <h2 style="margin-bottom:1.5rem;text-align:center">What happens next?</h2>
      <div style="display:grid;gap:1rem">
        {[
          ['1️⃣', 'Submission received', 'We receive your details immediately by email'],
          ['2️⃣', 'Manual review', 'We test the tool and check quality (24–48h)'],
          ['3️⃣', 'Live in the directory', 'Your tool appears with a full dedicated page'],
          ['4️⃣', 'Organic traffic', 'SEO-optimized tool page brings you free visitors'],
        ].map(([num, title, desc]) => (
          <div class="card" style="display:flex;gap:1.25rem;align-items:center">
            <span style="font-size:1.75rem;flex-shrink:0">{num}</span>
            <div>
              <strong style="display:block;margin-bottom:0.25rem">{title}</strong>
              <span style="color:var(--text-muted);font-size:0.85rem">{desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
.form-input {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.75rem 1rem;
  color: var(--text);
  font-size: 0.92rem;
  font-family: var(--font-sans);
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
  appearance: none;
}
.form-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(124,106,247,0.12);
}
.form-input::placeholder { color: var(--text-muted); }
select.form-input { cursor: pointer; }
textarea.form-input { resize: vertical; min-height: 80px; }
</style>

<script>
// Handle Formspree AJAX submit for better UX
const form = document.getElementById('tool-form') as HTMLFormElement | null;
const successMsg = document.getElementById('success-msg');
const formWrap   = document.getElementById('submit-form-wrap');
const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement | null;

form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (submitBtn) {
    submitBtn.textContent = '⏳ Submitting...';
    submitBtn.disabled = true;
  }

  try {
    const data = new FormData(form);
    const res  = await fetch('https://formspree.io/f/xojbpode', {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' },
    });

    if (res.ok) {
      if (formWrap)  formWrap.style.display  = 'none';
      if (successMsg) successMsg.style.display = 'block';
    } else {
      if (submitBtn) {
        submitBtn.textContent = '❌ Error — try again';
        submitBtn.disabled = false;
      }
    }
  } catch {
    if (submitBtn) {
      submitBtn.textContent = '❌ Network error — try again';
      submitBtn.disabled = false;
    }
  }
});
</script>

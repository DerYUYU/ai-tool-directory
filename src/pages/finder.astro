  var STEP_LABELS = { 1:'Step 1 of 3', 2:'Step 2 of 3', 3:'Step 3 of 3', results:'Your Recommendations ✓' };

  function goStep(s) {
    document.querySelectorAll('.step-panel').forEach(function(p) { p.classList.remove('active'); });
    var id = s === 'results' ? 'step-results' : 'step-' + s;
    var panel = document.getElementById(id);
    if (panel) panel.classList.add('active');

    // Progress bars
    var bars = ['p1','p2','p3','pdone'];
    bars.forEach(function(bid, i) {
      var el = document.getElementById(bid);
      if (!el) return;
      el.classList.remove('active','done');
      if (s === 'results') {
        el.classList.add('done');
      } else if (i < s - 1) {
        el.classList.add('done');
      } else if (i === s - 1) {
        el.classList.add('active');
      }
    });

    var lbl = document.getElementById('step-label');
    if (lbl) lbl.textContent = STEP_LABELS[s] || '';
  }

  /* ══════════════════════════════════════════════════════════════
     CHOICE WIRING
  ══════════════════════════════════════════════════════════════ */
  function wireChoices(containerId, key, nextFn) {
    var wrap = document.getElementById(containerId);
    if (!wrap) return;
    wrap.querySelectorAll('.choice-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        wrap.querySelectorAll('.choice-btn').forEach(function(b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        ans[key] = btn.getAttribute('data-v');
        setTimeout(nextFn, 230);
      });
    });
  }

  wireChoices('c1', 'cat',    function() { goStep(2); });
  wireChoices('c2', 'persona', function() { goStep(3); });
  wireChoices('c3', 'budget', function() { buildResults(); goStep('results'); });

  /* ── Back buttons ── */
  var b2 = document.getElementById('back-2');
  var b3 = document.getElementById('back-3');
  if (b2) b2.addEventListener('click', function() { goStep(1); });
  if (b3) b3.addEventListener('click', function() { goStep(2); });

  /* ── Restart ── */
  var btnR = document.getElementById('btn-restart');
  if (btnR) btnR.addEventListener('click', function() {
    ans = { cat: null, persona: null, budget: null };
    document.querySelectorAll('.choice-btn').forEach(function(b) { b.classList.remove('selected'); });
    goStep(1);
  });

  /* ══════════════════════════════════════════════════════════════
     RECOMMENDATION ALGORITHM
  ══════════════════════════════════════════════════════════════ */
  function buildResults() {
    var cat     = ans.cat;
    var persona = ans.persona;
    var budget  = parseInt(ans.budget, 10);

    // devtools → treat as coding + devtools
    var catFilter = cat === 'devtools' ? ['coding','devtools'] : [cat];

    // 1. Filter: category must match
    var pool = DB.filter(function(t) {
      return t.cats.some(function(c) { return catFilter.indexOf(c) !== -1; });
    });

    // 2. Filter: budget
    pool = pool.filter(function(t) {
      if (budget === 0) return t.free === true;
      return t.free === true || t.price <= budget;
    });

    // 3. Score: persona + small free bonus
    pool = pool.map(function(t) {
      var score = 0;
      if (t.personas.indexOf('all')     !== -1) score += 1;
      if (t.personas.indexOf(persona)   !== -1) score += 2;
      if (persona === 'individual' && t.free)        score += 0.5;
      if (persona === 'startup'      && !t.free && t.price <= 30) score += 0.5;
      return { t: t, s: score };
    });

    pool.sort(function(a, b) { return b.s - a.s; });

    renderResults(pool.slice(0,3).map(function(x) { return x.t; }));
  }

  /* ══════════════════════════════════════════════════════════════
     RENDER RESULTS
  ══════════════════════════════════════════════════════════════ */
  function renderResults(tools) {
    var catLabels = {
      writing:'Write text', coding:'Write code', design:'Design & Images',
      video:'Create videos', research:'Research', productivity:'Productivity',
      business:'Business', devtools:'Build an AI app'
    };
    var personaLabels = { individual:'Individual', freelancer:'Freelancer', startup:'Startup/Team', enterprise:'Enterprise' };
    var budgetLabels  = { '0':'Free only', '20':'up to €20/mo', '100':'up to €100/mo', '9999':'No limit' };
    var ranks = ['🥇','🥈','🥉'];

    var sub = document.getElementById('res-sub');
    if (sub) {
      sub.textContent = (catLabels[ans.cat] || '') + '  ·  ' + (personaLabels[ans.persona] || '') + '  ·  ' + (budgetLabels[ans.budget] || '');
    }

    var list = document.getElementById('res-list');
    if (!list) return;
    list.innerHTML = '';

    if (!tools.length) {
      list.innerHTML = '<div class="no-results"><p>No matching tools found for this combination.</p><p>Try a <a href="javascript:void(0)" id="retry-link">higher budget</a> or a different use case.</p></div>';
      var retry = document.getElementById('retry-link');
      if (retry) retry.addEventListener('click', function() { goStep(3); });
      return;
    }

    tools.forEach(function(t, i) {
      var a = document.createElement('a');
      a.href = t.href;
      a.className = 'result-card' + (i === 0 ? ' gold' : '');
      a.innerHTML =
        '<div class="result-rank">' + (ranks[i] || '') + '</div>' +
        '<div class="result-body">' +
          '<div class="result-name">' + t.name + '</div>' +
          '<div class="result-tagline">' + t.tagline + '</div>' +
          '<div class="result-reason">' + t.reason + '</div>' +
          '<div class="result-tags">' +
            (t.free ? '<span class="tag tag-free">✓ Free tier</span>' : '') +
            '<span class="tag tag-price">' + (t.price === 0 ? 'Free' : 'from €' + t.price + '/mo') + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="result-arrow">→</div>';
      list.appendChild(a);
    });
  }

  /* ══════════════════════════════════════════════════════════════
     PHASE B: FREITEXT-SUCHE
  ══════════════════════════════════════════════════════════════ */
  var searchInput = document.getElementById('finder-search');
  var searchResults = document.getElementById('search-results');

  if (searchInput && searchResults) {
    searchInput.addEventListener('focus', function() {
      this.style.borderColor = 'var(--accent)';
    });
    searchInput.addEventListener('blur', function() {
      this.style.borderColor = 'var(--border)';
      setTimeout(function() { searchResults.style.display = 'none'; }, 200);
    });

    searchInput.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      if (q.length < 2) { searchResults.style.display = 'none'; return; }

      var hits = DB.filter(function(t) {
        return t.name.toLowerCase().includes(q)
          || t.tagline.toLowerCase().includes(q)
          || (t.cats && t.cats.some(function(c) { return c.includes(q); }));
      }).slice(0, 8);

      if (!hits.length) {
        searchResults.innerHTML = '<div style="padding:0.9rem 1rem;color:var(--text-muted);font-size:0.85rem">No tool found for "' + q + '"</div>';
        searchResults.style.display = 'block';
        return;
      }

      searchResults.innerHTML = hits.map(function(t) {
        var freeTag = t.free ? '<span style="font-size:0.65rem;padding:1px 6px;border-radius:99px;background:rgba(34,197,94,0.12);color:#22c55e;border:1px solid rgba(34,197,94,0.2)">Free</span>' : '';
        return '<a href="' + t.href + '" style="display:flex;align-items:center;gap:0.75rem;padding:0.7rem 1rem;text-decoration:none;color:var(--text);transition:background 0.15s;border-bottom:1px solid var(--border)" onmouseover="this.style.background=\'var(--bg-card-hover)\'" onmouseout="this.style.background=\'transparent\'">'
          + '<span style="font-size:1.4rem;width:28px;text-align:center;flex-shrink:0">' + t.icon + '</span>'
          + '<span style="flex:1;min-width:0">'
          + '<span style="font-size:0.88rem;font-weight:600;display:block">' + t.name + '</span>'
          + '<span style="font-size:0.75rem;color:var(--text-muted)">' + t.tagline + '</span>'
          + '</span>'
          + freeTag
          + '</a>';
      }).join('');
      searchResults.lastElementChild.style.borderBottom = 'none';
      searchResults.style.display = 'block';
    });
  }

})();
</script>

</BaseLayout>

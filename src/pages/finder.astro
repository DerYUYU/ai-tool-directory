---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="KI-Finder — Finde dein perfektes KI-Tool"
  description="Beantworte 3 kurze Fragen und erhalte sofort persönliche KI-Tool-Empfehlungen — kostenlos, ohne Anmeldung."
>

<style>
  /* ── Hero ── */
  .finder-hero {
    text-align: center;
    padding: 4rem 1rem 2rem;
    animation: fadeUp 0.6s ease both;
  }
  .finder-hero-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
    animation: float 4s ease-in-out infinite;
  }
  .finder-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }
  .finder-hero p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Progress ── */
  .progress-wrap {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem auto 0;
    max-width: 280px;
  }
  .prog-bar {
    flex: 1;
    height: 4px;
    border-radius: 99px;
    background: var(--border);
    transition: background 0.4s ease;
  }
  .prog-bar.active { background: var(--accent); }
  .prog-bar.done   { background: var(--green); }
  .step-label-text {
    display: block;
    text-align: center;
    margin-top: 0.75rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  /* ── Step container ── */
  .step-wrap {
    max-width: 700px;
    margin: 2rem auto 5rem;
    padding: 0 1rem;
  }
  .step-panel { display: none; }
  .step-panel.active {
    display: block;
    animation: fadeUp 0.35s ease both;
  }

  .step-q {
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    font-weight: 700;
    color: var(--text);
    text-align: center;
    margin-bottom: 0.4rem;
  }
  .step-hint {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }

  /* ── Choices grid ── */
  .choices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 0.7rem;
  }
  .choice-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: all 0.18s ease;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    user-select: none;
    line-height: 1.3;
  }
  .choice-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(124,106,247,0.18);
  }
  .choice-btn.selected {
    background: var(--accent-dim);
    border-color: var(--border-bright);
    color: var(--accent-light);
  }
  .choice-icon { font-size: 1.9rem; }

  /* ── Back btn ── */
  .btn-back {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    padding: 0.45rem 1rem;
    cursor: pointer;
    margin-bottom: 1.75rem;
    transition: all 0.18s;
  }
  .btn-back:hover { border-color: var(--border-bright); color: var(--text); }

  /* ── Results ── */
  .results-headline {
    text-align: center;
    font-size: clamp(1.3rem, 4vw, 1.8rem);
    font-weight: 800;
    margin-bottom: 0.35rem;
  }
  .results-sub {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }
  .result-list { display: flex; flex-direction: column; gap: 0.85rem; }

  .result-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.18s ease;
  }
  .result-card:hover {
    border-color: var(--accent);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.5);
  }
  .result-card.gold {
    border-color: rgba(124,106,247,0.45);
    background: linear-gradient(135deg, rgba(124,106,247,0.08) 0%, rgba(34,211,238,0.03) 100%);
  }
  .result-rank {
    font-size: 1.6rem;
    width: 34px;
    flex-shrink: 0;
    text-align: center;
    margin-top: 2px;
  }
  .result-body { flex: 1; min-width: 0; }
  .result-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.15rem;
  }
  .result-tagline {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.55rem;
  }
  .result-reason {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.6rem;
  }
  .result-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag {
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 99px;
    font-weight: 600;
  }
  .tag-free {
    background: rgba(34,197,94,0.12);
    color: var(--green);
    border: 1px solid rgba(34,197,94,0.25);
  }
  .tag-price {
    background: var(--accent-dim);
    color: var(--accent-light);
    border: 1px solid rgba(124,106,247,0.2);
  }
  .result-arrow {
    color: var(--text-dim);
    font-size: 1.1rem;
    align-self: center;
    flex-shrink: 0;
    transition: transform 0.18s;
  }
  .result-card:hover .result-arrow { transform: translateX(3px); color: var(--accent-light); }

  .restart-row { text-align: center; margin-top: 2.5rem; }
  .btn-restart {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.6rem 1.5rem;
    cursor: pointer;
    transition: all 0.18s;
  }
  .btn-restart:hover { border-color: var(--accent); color: var(--accent-light); }

  /* ── No results ── */
  .no-results {
    text-align: center;
    padding: 2.5rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .no-results a { color: var(--accent-light); }

  @media (max-width: 480px) {
    .choices { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<!-- ── Hero ── -->
<div class="container">
  <div class="finder-hero">
    <span class="finder-hero-icon">🤖</span>
    <h1>KI-Finder</h1>
    <p>
      3 kurze Fragen — ich empfehle dir die besten KI-Tools
      für deinen Use-Case. Kostenlos, sofort, ohne Anmeldung.
    </p>

    <!-- Progress -->
    <div class="progress-wrap">
      <div class="prog-bar active" id="p1"></div>
      <div class="prog-bar" id="p2"></div>
      <div class="prog-bar" id="p3"></div>
      <div class="prog-bar" id="pdone"></div>
    </div>
    <span class="step-label-text" id="step-label">Schritt 1 von 3</span>
  </div>

  <!-- ── Steps ── -->
  <div class="step-wrap">

    <!-- Step 1 -->
    <div class="step-panel active" id="step-1">
      <h2 class="step-q">Was willst du mit KI machen?</h2>
      <p class="step-hint">Wähle deinen wichtigsten Use-Case</p>
      <div class="choices" id="c1">
        <button class="choice-btn" data-v="writing">   <span class="choice-icon">✍️</span>Texte schreiben</button>
        <button class="choice-btn" data-v="coding">    <span class="choice-icon">💻</span>Code schreiben</button>
        <button class="choice-btn" data-v="design">    <span class="choice-icon">🎨</span>Bilder & Design</button>
        <button class="choice-btn" data-v="video">     <span class="choice-icon">🎬</span>Videos erstellen</button>
        <button class="choice-btn" data-v="research">  <span class="choice-icon">🔬</span>Recherchieren</button>
        <button class="choice-btn" data-v="productivity"><span class="choice-icon">⚡</span>Produktiver werden</button>
        <button class="choice-btn" data-v="business">  <span class="choice-icon">💼</span>Business automatisieren</button>
        <button class="choice-btn" data-v="devtools">  <span class="choice-icon">🚀</span>KI-App bauen</button>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="step-panel" id="step-2">
      <button class="btn-back" id="back-2">← Zurück</button>
      <h2 class="step-q">Wer bist du?</h2>
      <p class="step-hint">Damit ich passende Tools empfehlen kann</p>
      <div class="choices" id="c2">
        <button class="choice-btn" data-v="privatperson"><span class="choice-icon">👤</span>Privatperson</button>
        <button class="choice-btn" data-v="freelancer">  <span class="choice-icon">💼</span>Freelancer</button>
        <button class="choice-btn" data-v="startup">     <span class="choice-icon">🚀</span>Startup / Team</button>
        <button class="choice-btn" data-v="unternehmen"> <span class="choice-icon">🏢</span>Unternehmen</button>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="step-panel" id="step-3">
      <button class="btn-back" id="back-3">← Zurück</button>
      <h2 class="step-q">Was ist dein monatliches Budget?</h2>
      <p class="step-hint">Ich filtere die besten Tools für dich</p>
      <div class="choices" id="c3">
        <button class="choice-btn" data-v="0">    <span class="choice-icon">🆓</span>Nur kostenlos</button>
        <button class="choice-btn" data-v="20">   <span class="choice-icon">💶</span>Bis €20 / Monat</button>
        <button class="choice-btn" data-v="100">  <span class="choice-icon">💰</span>Bis €100 / Monat</button>
        <button class="choice-btn" data-v="9999"> <span class="choice-icon">♾️</span>Budget egal</button>
      </div>
    </div>

    <!-- Results -->
    <div class="step-panel" id="step-results">
      <h2 class="results-headline">Deine Top-Empfehlungen 🎯</h2>
      <p class="results-sub" id="res-sub"></p>
      <div class="result-list" id="res-list"></div>
      <div class="restart-row">
        <button class="btn-restart" id="btn-restart">↺ Neu starten</button>
      </div>
    </div>

  </div><!-- /.step-wrap -->
</div><!-- /.container -->

<!-- ══════════════════════════════════════════════════════════
     BROWSE BY CATEGORY
══════════════════════════════════════════════════════════ -->
<section style="padding:4rem 0 3rem;border-top:1px solid var(--border);margin-top:1rem">
  <div class="container">
    <h2 style="text-align:center;font-size:1.4rem;font-weight:700;margin-bottom:0.5rem">
      Oder direkt nach Kategorie browsen
    </h2>
    <p style="text-align:center;color:var(--text-muted);font-size:0.9rem;margin-bottom:2.25rem">
      Alle KI-Tools sortiert nach Einsatzgebiet
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:0.75rem;max-width:800px;margin:0 auto">
      <a href="/categories/Writing"      class="cat-tile"><span class="ct-icon">✍️</span><span>Writing</span></a>
      <a href="/categories/Coding"       class="cat-tile"><span class="ct-icon">💻</span><span>Coding</span></a>
      <a href="/categories/Design"       class="cat-tile"><span class="ct-icon">🎨</span><span>Design</span></a>
      <a href="/categories/Video"        class="cat-tile"><span class="ct-icon">🎬</span><span>Video</span></a>
      <a href="/categories/Research"     class="cat-tile"><span class="ct-icon">🔬</span><span>Research</span></a>
      <a href="/categories/Productivity" class="cat-tile"><span class="ct-icon">⚡</span><span>Productivity</span></a>
      <a href="/categories/Business"     class="cat-tile"><span class="ct-icon">💼</span><span>Business</span></a>
      <a href="/categories/Audio"        class="cat-tile"><span class="ct-icon">🎵</span><span>Audio</span></a>
    </div>

    <div style="text-align:center;margin-top:1.75rem">
      <a href="/" class="btn btn-ghost" style="font-size:0.85rem;padding:0.55rem 1.4rem">
        Alle Tools ansehen →
      </a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     WHY AI TOOL DIRECTORY + NEWSLETTER
══════════════════════════════════════════════════════════ -->
<section style="padding:3rem 0 5rem">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;max-width:900px;margin:0 auto">

      <!-- Trust Block -->
      <div class="card" style="padding:2rem;display:flex;flex-direction:column;gap:1.25rem">
        <div style="font-size:1.75rem">🏆</div>
        <h3 style="font-size:1.05rem;font-weight:700;margin:0">Warum AI Tool Directory?</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.65rem">
          <li style="display:flex;gap:0.65rem;align-items:flex-start;font-size:0.88rem;color:var(--text-muted)">
            <span style="color:var(--green);flex-shrink:0">✓</span>
            <span><strong style="color:var(--text)">40+ Tools</strong> — kuratiert & täglich aktualisiert</span>
          </li>
          <li style="display:flex;gap:0.65rem;align-items:flex-start;font-size:0.88rem;color:var(--text-muted)">
            <span style="color:var(--green);flex-shrink:0">✓</span>
            <span><strong style="color:var(--text)">Ehrliche Bewertungen</strong> — keine bezahlten Platzierungen</span>
          </li>
          <li style="display:flex;gap:0.65rem;align-items:flex-start;font-size:0.88rem;color:var(--text-muted)">
            <span style="color:var(--green);flex-shrink:0">✓</span>
            <span><strong style="color:var(--text)">Preise & Free Tiers</strong> — sofort vergleichbar</span>
          </li>
          <li style="display:flex;gap:0.65rem;align-items:flex-start;font-size:0.88rem;color:var(--text-muted)">
            <span style="color:var(--green);flex-shrink:0">✓</span>
            <span><strong style="color:var(--text)">Auf Deutsch</strong> — das größte deutschsprachige KI-Verzeichnis</span>
          </li>
        </ul>
      </div>

      <!-- Newsletter Block -->
      <div class="card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem;background:linear-gradient(135deg,rgba(124,106,247,0.08),rgba(34,211,238,0.04))">
        <div style="font-size:1.75rem">📬</div>
        <h3 style="font-size:1.05rem;font-weight:700;margin:0">Neue Tools per Newsletter</h3>
        <p style="font-size:0.87rem;color:var(--text-muted);margin:0;line-height:1.6">
          Wöchentlich die besten neuen KI-Tools — direkt in dein Postfach.
          Kein Spam, jederzeit abmeldbar.
        </p>
        <a href="/newsletter" class="btn btn-primary" style="font-size:0.85rem;padding:0.6rem 1.2rem;text-align:center">
          📬 Kostenlos abonnieren
        </a>
        <p style="font-size:0.72rem;color:var(--text-dim);margin:0;text-align:center">
          Bereits angemeldet? <a href="/" style="color:var(--accent)">Alle Tools entdecken →</a>
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .cat-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.83rem;
    font-weight: 500;
    transition: all 0.18s ease;
    text-align: center;
  }
  .cat-tile:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(124,106,247,0.15);
  }
  .ct-icon { font-size: 1.6rem; }
  @media (max-width: 600px) {
    section > .container > div[style*="grid-template-columns:1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script is:inline>
(function () {

  /* ══════════════════════════════════════════════════════════════
     TOOL DATABASE
     cats: array of categories this tool belongs to
     personas: ['all'] or specific ['privatperson','freelancer','startup','unternehmen']
     free: has a usable free tier
     price: starting paid price (€/mo, approx)
  ══════════════════════════════════════════════════════════════ */
  var DB = [
    /* ─── Writing ─── */
    { id:'chatgpt',         name:'ChatGPT',           tagline:'Universeller KI-Assistent',        icon:'💬', href:'/tools/chatgpt',          free:true,  price:20,  cats:['writing','coding','research','productivity'], personas:['all'],                                reason:'Der vielseitigste Allround-Assistent — schreibt Texte, erklärt Code, beantwortet jede Frage.' },
    { id:'claude',          name:'Claude',             tagline:'Bester KI für lange Texte',        icon:'🤖', href:'/tools/claude',            free:true,  price:20,  cats:['writing','research','coding'],               personas:['freelancer','startup'],               reason:'Unschlagbar bei langen Dokumenten und präzisen, natürlichen Texten.' },
    { id:'gemini',          name:'Gemini',             tagline:'Googles KI mit Web-Zugang',        icon:'✨', href:'/tools/gemini',            free:true,  price:20,  cats:['writing','research','coding'],               personas:['all'],                                reason:'Kostenlos, aktuelle Web-Infos und Google Workspace Integration.' },
    { id:'deepseek',        name:'DeepSeek',           tagline:'Kostenloser GPT-4-Konkurrent',     icon:'🔬', href:'/tools/deepseek',          free:true,  price:0,   cats:['writing','coding','research'],               personas:['privatperson','freelancer'],          reason:'Vollkommen kostenlos und extrem leistungsfähig — die beste Gratis-Alternative.' },
    { id:'jasper-ai',       name:'Jasper AI',          tagline:'KI für Marketing-Texte',           icon:'📢', href:'/tools/jasper-ai',         free:false, price:49,  cats:['writing','business'],                        personas:['startup','unternehmen'],              reason:'Speziell für Marketing-Content — hunderte Templates für Ads, Blog und Social Media.' },
    { id:'copy-ai',         name:'Copy.ai',            tagline:'Schnelle Marketing-Texte',         icon:'📝', href:'/tools/copy-ai',           free:true,  price:49,  cats:['writing','business'],                        personas:['freelancer','startup'],               reason:'Hunderte Vorlagen für Werbetexte und Social Media Posts — sofort einsatzbereit.' },
    { id:'writesonic',      name:'Writesonic',         tagline:'SEO-optimierte Artikel',           icon:'📖', href:'/tools/writesonic',        free:true,  price:20,  cats:['writing'],                                   personas:['freelancer','startup'],               reason:'Speziell für SEO-Artikel — integrierte Keyword-Optimierung für besseres Google-Ranking.' },
    { id:'grammarly',       name:'Grammarly',          tagline:'KI-Rechtschreibung & Stil',        icon:'✅', href:'/tools/grammarly',         free:true,  price:12,  cats:['writing'],                                   personas:['privatperson','freelancer'],          reason:'Verbessert Grammatik und Schreibstil in Echtzeit — läuft in jedem Browser.' },
    { id:'wordtune',        name:'Wordtune',           tagline:'Texte umschreiben & verbessern',   icon:'✏️', href:'/tools/wordtune',          free:true,  price:10,  cats:['writing'],                                   personas:['privatperson','freelancer'],          reason:'Macht jeden Satz klarer und professioneller — perfekt für Englisch.' },
    /* ─── Coding ─── */
    { id:'github-copilot',  name:'GitHub Copilot',     tagline:'KI direkt im Code-Editor',         icon:'💻', href:'/tools/github-copilot',    free:false, price:10,  cats:['coding'],                                    personas:['freelancer','startup','unternehmen'], reason:'Direkt in VS Code integriert — vervollständigt Code in Echtzeit, spart Stunden täglich.' },
    { id:'cursor',          name:'Cursor',             tagline:'Der KI-Code-Editor',               icon:'⚡', href:'/tools/cursor',            free:true,  price:20,  cats:['coding'],                                    personas:['freelancer','startup'],               reason:'Schreibt, erklärt und refactort ganzen Code auf einmal — besser als Copilot.' },
    { id:'windsurf',        name:'Windsurf',           tagline:'Autonomes KI-Coding',              icon:'🏄', href:'/tools/windsurf',          free:true,  price:15,  cats:['coding'],                                    personas:['freelancer','startup'],               reason:'Neuester KI-Editor — autonomer als Cursor, ideal für komplexe Features.' },
    { id:'bolt-new',        name:'Bolt.new',           tagline:'Web-Apps ohne Setup bauen',        icon:'⚡', href:'/tools/bolt-new',          free:true,  price:20,  cats:['coding','devtools'],                         personas:['privatperson','freelancer'],          reason:'Komplette Web-Apps per Prompt im Browser — kein Node.js, kein Setup nötig.' },
    { id:'lovable',         name:'Lovable',            tagline:'Apps ohne Code erstellen',         icon:'💖', href:'/tools/lovable',           free:true,  price:20,  cats:['coding','devtools'],                         personas:['privatperson','freelancer','startup'], reason:'Vollständige Web-Apps per Chat — direkt deployen ohne eine Zeile Code zu schreiben.' },
    { id:'replit-ai',       name:'Replit AI',          tagline:'Coden ohne Installation',          icon:'🔧', href:'/tools/replit-ai',         free:true,  price:25,  cats:['coding'],                                    personas:['privatperson','freelancer'],          reason:'Coding im Browser ohne Installation — perfekt für Einsteiger und schnelle Prototypen.' },

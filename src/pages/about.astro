---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const categories = ['Writing', 'Coding', 'Design', 'Productivity', 'Video', 'Audio', 'Business', 'Research'];
---

<BaseLayout
  title="About Tooly-AI — The Largest AI Tool Directory"
  description="Who is behind Tooly-AI? Our goal: the most honest and complete AI tool directory on the web."
>
  <div class="container" style="padding-top:5rem;padding-bottom:6rem;max-width:800px">

    <!-- Hero -->
    <div style="text-align:center;margin-bottom:4rem">
      <div class="badge badge-new" style="margin-bottom:1.5rem">
        🤖 About us
      </div>
      <h1 style="margin-bottom:1rem">The <span class="grad-text">most honest</span> AI tool directory</h1>
      <p style="color:var(--text-muted);font-size:1.1rem;line-height:1.75;max-width:580px;margin:0 auto">
        No pay-to-play. No hidden recommendations. Only tools we have genuinely tested
        and found to be good.
      </p>
    </div>

    <!-- Mission -->
    <div class="card" style="
      background:linear-gradient(135deg,rgba(124,106,247,0.08),rgba(34,211,238,0.04));
      border-color:rgba(124,106,247,0.25);
      padding:3rem;
      margin-bottom:2.5rem;
    ">
      <h2 style="margin-bottom:1.25rem">🎯 Our Mission</h2>
      <p style="color:var(--text-muted);line-height:1.8;font-size:1.02rem">
        AI tools are evolving at a breakneck pace. New products appear every day,
        prices change and some tools disappear again. It is nearly impossible
        to keep up.
      </p>
      <p style="color:var(--text-muted);line-height:1.8;font-size:1.02rem;margin-top:1rem">
        <strong style="color:var(--text)">Tooly-AI</strong> exists so you no longer have to.
        We curate, test and rate AI tools daily — so you can find the perfect tool
        for your use case in minutes.
      </p>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2.5rem;text-align:center">
      <div class="card" style="padding:2rem">
        <div class="stat-number">{allTools.length}+</div>
        <div class="stat-label">Curated tools</div>
      </div>
      <div class="card" style="padding:2rem">
        <div class="stat-number">{categories.length}</div>
        <div class="stat-label">Categories</div>
      </div>
      <div class="card" style="padding:2rem">
        <div class="stat-number">€0</div>
        <div class="stat-label">Cost to you</div>
      </div>
    </div>

    <!-- Principles -->
    <h2 style="margin-bottom:1.5rem">🤝 Our Principles</h2>
    <div style="display:grid;gap:1rem;margin-bottom:3rem">
      {[
        ['🎯', 'Honesty over commissions', 'When we have affiliate links, we always label them clearly. Our judgement is never influenced by commissions.'],
        ['🔬', 'Only tested tools', 'We do not add tools we have not at least briefly tested. No blind-purchase risk for you.'],
        ['🆓', 'Free-tier focus', 'We specifically highlight free tiers — because we believe great tools should also be accessible at no cost.'],
        ['📅', 'Updated daily', 'Prices, availability and features change. We keep the data as up to date as possible.'],
        ['🚫', 'No pay-to-play', 'No company can buy their way in. Rankings are based on quality only.'],
      ].map(([emoji, title, desc]) => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start">
          <span style="font-size:1.75rem;flex-shrink:0">{emoji}</span>
          <div>
            <strong style="display:block;margin-bottom:0.35rem">{title}</strong>
            <span style="color:var(--text-muted);font-size:0.88rem;line-height:1.6">{desc}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Affiliate Disclosure -->
    <div class="card" style="background:rgba(245,158,11,0.06);border-color:rgba(245,158,11,0.25);margin-bottom:2.5rem">
      <h3 style="color:var(--yellow);margin-bottom:0.75rem">💰 Affiliate Transparency</h3>
      <p style="color:var(--text-muted);font-size:0.9rem;line-height:1.7">
        Some links on this site are affiliate links — meaning we receive a small commission
        if you purchase a tool through our link. This costs you nothing extra.
        Such links are always marked with 💰. Our reviews are <strong>not</strong> influenced by this.
      </p>
    </div>

    <!-- Contact / CTA -->
    <div style="text-align:center">
      <h2 style="margin-bottom:1rem">Submit a tool or have questions?</h2>
      <p style="color:var(--text-muted);margin-bottom:2rem">
        Missing a tool in the directory? Found an error? We welcome your feedback.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a href="/submit"     class="btn btn-primary"  style="padding:0.8rem 2rem">🚀 Submit a tool</a>
        <a href="/newsletter" class="btn btn-outline"  style="padding:0.8rem 2rem">📬 Newsletter</a>
        <a href="mailto:yilcay.b@gmail.com" class="btn btn-ghost" style="padding:0.8rem 2rem">✉️ Contact</a>
      </div>
    </div>
  </div>
</BaseLayout>

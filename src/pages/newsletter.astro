---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Tools Newsletter — New every week"
  description="Subscribe to the free AI Tools Newsletter and receive the 10 best new AI tools straight to your inbox every week."
>
  <div class="container" style="padding-top:5rem;padding-bottom:6rem;max-width:680px">

    <!-- Hero -->
    <div style="text-align:center;margin-bottom:3.5rem">
      <div style="
        font-size:4rem;
        margin-bottom:1.25rem;
        display:inline-block;
        animation: float 3s ease-in-out infinite;
      ">📬</div>
      <h1 style="margin-bottom:1rem">AI Tools Newsletter</h1>
      <p style="color:var(--text-muted);font-size:1.1rem;line-height:1.75;max-width:500px;margin:0 auto">
        Every week the <strong style="color:var(--text)">10 best new AI tools</strong> —
        straight to your inbox. Free. No spam. Unsubscribe anytime.
      </p>
    </div>

    <!-- Subscribe Form -->
    <div class="card" style="
      background:linear-gradient(135deg,rgba(124,106,247,0.08),rgba(34,211,238,0.04));
      border-color:rgba(124,106,247,0.25);
      text-align:center;
      padding:3rem 2.5rem;
      position:relative;
      overflow:hidden;
      margin-bottom:2.5rem;
    ">
      <!-- Glow -->
      <div style="
        position:absolute;top:50%;left:50%;
        transform:translate(-50%,-50%);
        width:400px;height:300px;
        background:radial-gradient(ellipse,rgba(124,106,247,0.1) 0%,transparent 70%);
        pointer-events:none;
      "></div>

      <div style="position:relative;z-index:1">
        <div class="badge badge-new" style="margin-bottom:1.5rem">
          ✨ Free · No spam
        </div>
        <h2 style="margin-bottom:0.5rem">Subscribe now</h2>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:2rem">
          Join thousands who discover AI tools first.
        </p>

        <!-- Success state -->
        <div id="nl-success" style="display:none">
          <div style="font-size:2.5rem;margin-bottom:0.75rem">🎉</div>
          <h3 style="color:var(--green);margin-bottom:0.5rem">Successfully subscribed!</h3>
          <p style="color:var(--text-muted);font-size:0.9rem">Check your email — you'll receive a confirmation.</p>
        </div>

        <!-- Form -->
        <form id="nl-form" style="max-width:440px;margin:0 auto"
          action="https://formspree.io/f/xojbpode"
          method="POST">
          <input type="hidden" name="_subject" value="Newsletter Signup — Tooly-AI" />
          <!-- Honeypot: Bots füllen das aus → Formspree blockiert automatisch -->
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center">
            <input
              type="email"
              name="email"
              placeholder="your@email.com"
              required
              style="
                flex:1;
                min-width:220px;
                background:rgba(255,255,255,0.06);
                border:1px solid var(--border);
                border-radius:var(--radius-sm);
                padding:0.8rem 1.2rem;
                color:var(--text);
                font-size:1rem;
                font-family:var(--font-sans);
                outline:none;
                transition:border-color 0.2s;
              "
              onfocus="this.style.borderColor='var(--accent)'"
              onblur="this.style.borderColor='var(--border)'"
            />
            <button type="submit" id="nl-btn" class="btn btn-primary" style="padding:0.8rem 1.6rem;white-space:nowrap">
              Subscribe →
            </button>
          </div>

          <p style="font-size:0.75rem;color:var(--text-dim);margin-top:1rem">
            By subscribing you agree to receive weekly emails. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>

    <!-- What you get -->
    <h2 style="margin-bottom:1.5rem;text-align:center">What you get every week</h2>
    <div style="display:grid;gap:1rem;margin-bottom:3rem">
      {[
        ['🆕', 'Top 10 new AI tools', 'Carefully curated and rated every week — before everyone else knows about them'],
        ['💰', 'Best free tools', 'We find the free-tier deals and freemium offers for you'],
        ['⚡', 'Early access tips', 'Beta access, launch deals and limited offers'],
        ['📊', 'Honest price comparisons', 'Which plan is actually worth it? We do the math'],
        ['🚫', 'No spam, no fluff', 'Only tools we have tested ourselves — no pay-to-play recommendations'],
      ].map(([emoji, title, desc]) => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start">
          <span style="font-size:1.75rem;flex-shrink:0;margin-top:0.1rem">{emoji}</span>
          <div>
            <strong style="display:block;margin-bottom:0.3rem">{title}</strong>
            <span style="color:var(--text-muted);font-size:0.85rem;line-height:1.5">{desc}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Social Proof -->
    <div class="card" style="text-align:center;padding:2rem;background:rgba(34,197,94,0.06);border-color:rgba(34,197,94,0.2)">
      <div style="font-size:2rem;margin-bottom:0.75rem">⭐⭐⭐⭐⭐</div>
      <p style="font-style:italic;color:var(--text-muted);font-size:0.95rem;max-width:420px;margin:0 auto">
        "Finally a newsletter that shows me tools I actually use —
        no hype, just real recommendations."
      </p>
      <p style="font-size:0.8rem;color:var(--text-dim);margin-top:0.75rem">— First subscriber</p>
    </div>

  </div>
</BaseLayout>

<script>
const nlForm    = document.getElementById('nl-form') as HTMLFormElement | null;
const nlSuccess = document.getElementById('nl-success');
const nlBtn     = document.getElementById('nl-btn') as HTMLButtonElement | null;

nlForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (nlBtn) { nlBtn.textContent = '⏳...'; nlBtn.disabled = true; }

  try {
    const res = await fetch('https://formspree.io/f/xojbpode', {
      method: 'POST',
      body: new FormData(nlForm),
      headers: { Accept: 'application/json' },
    });
    if (res.ok) {
      nlForm.style.display = 'none';
      if (nlSuccess) nlSuccess.style.display = 'block';
    } else {
      if (nlBtn) { nlBtn.textContent = '❌ Try again'; nlBtn.disabled = false; }
    }
  } catch {
    if (nlBtn) { nlBtn.textContent = '❌ Network error'; nlBtn.disabled = false; }
  }
});
</script>

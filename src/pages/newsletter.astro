---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="KI-Tools Newsletter — Jede Woche neu"
  description="Abonniere den kostenlosen KI-Tools Newsletter und erhalte jede Woche die 10 besten neuen KI-Tools direkt in dein Postfach."
>
  <div class="container" style="padding-top:5rem;padding-bottom:6rem;max-width:680px">

    <!-- Hero -->
    <div style="text-align:center;margin-bottom:3.5rem">
      <div style="
        font-size:4rem;
        margin-bottom:1.25rem;
        display:inline-block;
        animation: float 3s ease-in-out infinite;
      ">📬</div>
      <h1 style="margin-bottom:1rem">KI-Tools Newsletter</h1>
      <p style="color:var(--text-muted);font-size:1.1rem;line-height:1.75;max-width:500px;margin:0 auto">
        Jede Woche die <strong style="color:var(--text)">10 besten neuen KI-Tools</strong> —
        direkt in dein Postfach. Kostenlos. Kein Spam. Jederzeit abmeldbar.
      </p>
    </div>

    <!-- Subscribe Form -->
    <div class="card" style="
      background:linear-gradient(135deg,rgba(124,106,247,0.08),rgba(34,211,238,0.04));
      border-color:rgba(124,106,247,0.25);
      text-align:center;
      padding:3rem 2.5rem;
      position:relative;
      overflow:hidden;
      margin-bottom:2.5rem;
    ">
      <!-- Glow -->
      <div style="
        position:absolute;top:50%;left:50%;
        transform:translate(-50%,-50%);
        width:400px;height:300px;
        background:radial-gradient(ellipse,rgba(124,106,247,0.1) 0%,transparent 70%);
        pointer-events:none;
      "></div>

      <div style="position:relative;z-index:1">
        <div class="badge badge-new" style="margin-bottom:1.5rem">
          ✨ Kostenlos · Kein Spam
        </div>
        <h2 style="margin-bottom:0.5rem">Jetzt abonnieren</h2>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:2rem">
          Werde Teil von Tausenden die KI-Tools als erste entdecken.
        </p>

        <!-- Success state -->
        <div id="nl-success" style="display:none">
          <div style="font-size:2.5rem;margin-bottom:0.75rem">🎉</div>
          <h3 style="color:var(--green);margin-bottom:0.5rem">Erfolgreich abonniert!</h3>
          <p style="color:var(--text-muted);font-size:0.9rem">Check deine E-Mails — du erhältst eine Bestätigung.</p>
        </div>

        <!-- Form -->
        <form id="nl-form" style="max-width:440px;margin:0 auto"
          action="https://formspree.io/f/xojbpode"
          method="POST">
          <input type="hidden" name="_subject" value="Newsletter Anmeldung — AI Tool Directory" />

          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center">
            <input
              type="email"
              name="email"
              placeholder="deine@email.com"
              required
              style="
                flex:1;
                min-width:220px;
                background:rgba(255,255,255,0.06);
                border:1px solid var(--border);
                border-radius:var(--radius-sm);
                padding:0.8rem 1.2rem;
                color:var(--text);
                font-size:1rem;
                font-family:var(--font-sans);
                outline:none;
                transition:border-color 0.2s;
              "
              onfocus="this.style.borderColor='var(--accent)'"
              onblur="this.style.borderColor='var(--border)'"
            />
            <button type="submit" id="nl-btn" class="btn btn-primary" style="padding:0.8rem 1.6rem;white-space:nowrap">
              Abonnieren →
            </button>
          </div>

          <p style="font-size:0.75rem;color:var(--text-dim);margin-top:1rem">
            Durch Abonnieren stimmst du dem Erhalt wöchentlicher E-Mails zu. Jederzeit abmeldbar.
          </p>
        </form>
      </div>
    </div>

    <!-- What you get -->
    <h2 style="margin-bottom:1.5rem;text-align:center">Was du jede Woche bekommst</h2>
    <div style="display:grid;gap:1rem;margin-bottom:3rem">
      {[
        ['🆕', 'Top 10 neue KI-Tools', 'Jede Woche sorgfältig kuratiert und bewertet — bevor alle davon wissen'],
        ['💰', 'Beste kostenlose Tools', 'Wir finden die Free-Tier Deals und Freemium-Angebote für dich'],
        ['⚡', 'Early Access Tipps', 'Beta-Zugänge, Launch-Deals und limitierte Angebote'],
        ['📊', 'Ehrliche Preisvergleiche', 'Welcher Plan lohnt sich wirklich? Wir rechnen es durch'],
        ['🚫', 'Kein Spam, kein Bullshit', 'Nur Tools die wir selbst getestet haben — keine Pay-to-Play Empfehlungen'],
      ].map(([emoji, title, desc]) => (
        <div class="card" style="display:flex;gap:1.25rem;align-items:flex-start">
          <span style="font-size:1.75rem;flex-shrink:0;margin-top:0.1rem">{emoji}</span>
          <div>
            <strong style="display:block;margin-bottom:0.3rem">{title}</strong>
            <span style="color:var(--text-muted);font-size:0.85rem;line-height:1.5">{desc}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Social Proof -->
    <div class="card" style="text-align:center;padding:2rem;background:rgba(34,197,94,0.06);border-color:rgba(34,197,94,0.2)">
      <div style="font-size:2rem;margin-bottom:0.75rem">⭐⭐⭐⭐⭐</div>
      <p style="font-style:italic;color:var(--text-muted);font-size:0.95rem;max-width:420px;margin:0 auto">
        "Endlich ein Newsletter der mir Tools zeigt die ich wirklich nutze —
        kein Hype, nur echte Empfehlungen."
      </p>
      <p style="font-size:0.8rem;color:var(--text-dim);margin-top:0.75rem">— Erster Abonnent</p>
    </div>

  </div>
</BaseLayout>

<script>
const nlForm    = document.getElementById('nl-form') as HTMLFormElement | null;
const nlSuccess = document.getElementById('nl-success');
const nlBtn     = document.getElementById('nl-btn') as HTMLButtonElement | null;

nlForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (nlBtn) { nlBtn.textContent = '⏳...'; nlBtn.disabled = true; }

  try {
    const res = await fetch(action, {
      method: 'POST',
      body: new FormData(nlForm),
      headers: { Accept: 'application/json' },
    });
    if (res.ok) {
      nlForm.style.display = 'none';
      if (nlSuccess) nlSuccess.style.display = 'block';
    } else {
      if (nlBtn) { nlBtn.textContent = '❌ Erneut versuchen'; nlBtn.disabled = false; }
    }
  } catch {
    if (nlBtn) { nlBtn.textContent = '❌ Netzwerkfehler'; nlBtn.disabled = false; }
  }
});
</script>
